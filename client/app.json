{
  "expo": {
    "name": "parkEasy",
    "slug": "parkEasy",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkeasy.client",
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
      }
    },
    "android": {
      "package": "com.parkeasy.client"
    },
    "icon": "./assets/parkicon.png",
    "splash": {
      "image": "./assets/parkicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "parkeasy",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ParkEasy to access your photos to save ticket images.",
          "savePhotosPermission": "Allow ParkEasy to save ticket images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}